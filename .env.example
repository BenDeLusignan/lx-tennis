# Copy this file to .env.local (gitignored) and fill it in. See README, "Setup".
# The app, `npm run db:*` and the scripts all read the same file.

# Where the database is. The URL picks the backend:
#   file:local.db                 local SQLite file in the repo root (development, works offline)
#   libsql://<name>.turso.io      hosted Turso, with DATABASE_AUTH_TOKEN set
DATABASE_URL=file:local.db

# Turso only. Leave empty for a local file.
DATABASE_AUTH_TOKEN=

# Where the photos of racquets that reviewers add are stored: a read-write token
# for a PUBLIC Vercel Blob store (Vercel project > Storage > Blob; connecting the
# store to the project adds this variable to Vercel itself). Leave it empty for
# local development: the photo is then written to public/images/racquets/uploads/
# (gitignored). Only `next dev` has that fallback: `npm run start` (a local
# production build) counts as production and refuses to add a racquet without a
# token. If you put a real token here, local uploads go to the PRODUCTION Blob
# store, so don't, unless you mean to.
BLOB_READ_WRITE_TOKEN=

# Signs the login cookie. At least 32 random characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Keep it secret. Changing it logs every reviewer out, and forgets the recent
# failed-attempt counts: the limiter's keys are hashed with it too.
SESSION_SECRET=
